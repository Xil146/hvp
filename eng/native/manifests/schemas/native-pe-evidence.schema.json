{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xil146.github.io/hvp/schemas/native-pe-evidence-v1.schema.json",
  "title": "HVP native PE verification evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "generatedUtc", "architecture", "recursiveImportsComplete", "unexpectedDlls", "systemDllAllowlist", "outputs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "hvp-native-pe-evidence" },
    "generatedUtc": { "type": "string", "format": "date-time" },
    "architecture": { "const": "AMD64" },
    "recursiveImportsComplete": { "const": true },
    "unexpectedDlls": { "type": "array", "maxItems": 0 },
    "systemDllAllowlist": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "outputs": { "type": "array", "minItems": 1 }
  }
}
