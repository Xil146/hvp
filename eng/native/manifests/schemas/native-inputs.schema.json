{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xil146.github.io/hvp/schemas/native-inputs-v2.schema.json",
  "title": "HVP native source lock v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "approvedSourceIds", "sources"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "kind": { "const": "hvp-native-source-lock" },
    "approvedSourceIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "tag", "tagObject", "commit", "archive", "signature", "pinToCommit", "licenseDeclared", "licenseConcluded", "owner", "patches"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "minLength": 1 },
        "tag": { "type": ["string", "null"] },
        "tagObject": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "url", "allowedRedirectHosts", "sha256"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "pattern": "^https://" },
            "allowedRedirectHosts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "fingerprint", "evidence"],
          "properties": {
            "status": { "enum": ["pending", "verified", "revoked", "revoked-reviewed", "not-available-reviewed"] },
            "fingerprint": { "type": ["string", "null"] },
            "evidence": { "type": ["string", "null"] }
          }
        },
        "pinToCommit": { "enum": ["pending", "verified"] },
        "licenseDeclared": { "type": "string", "minLength": 1 },
        "licenseConcluded": { "type": ["string", "null"] },
        "owner": { "type": "string", "minLength": 1 },
        "patches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["order", "path", "sha256"],
            "properties": {
              "order": { "type": "integer", "minimum": 1 },
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    }
  }
}
