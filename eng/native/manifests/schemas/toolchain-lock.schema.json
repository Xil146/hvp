{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xil146.github.io/hvp/schemas/native-toolchain-lock-v2.schema.json",
  "title": "HVP native toolchain lock v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "kind", "platform", "route", "architecture", "baseArchive", "packages", "requiredPackageIds", "packageDatabase", "notes"],
  "properties": {
    "$schema": { "const": "schemas/toolchain-lock.schema.json" },
    "schemaVersion": { "const": 2 },
    "kind": { "const": "hvp-native-toolchain-lock" },
    "platform": { "const": "windows-x64" },
    "route": { "const": "MSYS2 CLANG64" },
    "architecture": { "const": "x86_64" },
    "baseArchive": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/baseArchive" }] },
    "packages": { "type": "array", "items": { "$ref": "#/$defs/package" } },
    "requiredPackageIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "packageDatabase": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/packageDatabase" }] },
    "notes": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fingerprint": { "type": "string", "pattern": "^[0-9A-Fa-f]{40,64}$" },
    "hostList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$" }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "allowedRedirectHosts", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "allowedRedirectHosts": { "$ref": "#/$defs/hostList" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "allowedRedirectHosts", "sha256", "keyFingerprint", "status", "evidence"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "allowedRedirectHosts": { "$ref": "#/$defs/hostList" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "keyFingerprint": { "$ref": "#/$defs/fingerprint" },
        "status": { "const": "verified" },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "baseArchive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "architecture", "archive", "signature"],
      "properties": {
        "id": { "const": "msys2-base" },
        "version": { "type": "string", "minLength": 1 },
        "architecture": { "const": "x86_64" },
        "archive": { "$ref": "#/$defs/archive" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "packageName", "version", "architecture", "archive", "signature", "dependsOn"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "packageName": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "architecture": { "enum": ["x86_64", "any"] },
        "archive": { "$ref": "#/$defs/archive" },
        "signature": { "$ref": "#/$defs/signature" },
        "dependsOn": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "packageDatabase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "packageIds", "evidence"],
      "properties": {
        "path": { "const": "var/lib/pacman/local" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "packageIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "evidence": { "type": "string", "minLength": 1 }
      }
    }
  }
}
