{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xil146.github.io/hvp/schemas/native-policy-v2.schema.json",
  "title": "HVP native policy v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "forbiddenInputs", "nativeLoadPolicy", "required", "forbiddenOptionKeys", "effectiveEvidence", "effectiveAssertions"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "kind": { "const": "hvp-native-policy" },
    "forbiddenInputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "nativeLoadPolicy": { "type": "object" },
    "required": { "type": "object" },
    "forbiddenOptionKeys": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "effectiveEvidence": { "type": "object" },
    "effectiveAssertions": { "type": "object" }
  }
}
