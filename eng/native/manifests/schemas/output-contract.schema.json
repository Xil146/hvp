{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xil146.github.io/hvp/schemas/native-output-contract-v2.schema.json",
  "title": "HVP native output contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "architecture", "requiredRoles", "outputs", "closureEvidence"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "kind": { "const": "hvp-native-output-contract" },
    "architecture": { "const": "x64" },
    "requiredRoles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "sourceNode", "path", "sha256", "peMachine", "imports", "exports", "apiVersion", "licenseConclusion"],
        "properties": {
          "role": { "type": "string" }, "sourceNode": { "type": "string" },
          "path": { "type": ["string", "null"] },
          "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "peMachine": { "type": ["string", "null"] },
          "imports": { "type": ["array", "null"], "items": { "type": "string" } },
          "delayImports": { "type": ["array", "null"], "items": { "type": "string" } },
          "exports": { "type": ["array", "null"], "items": { "type": "string" } },
          "dllCharacteristics": { "type": ["string", "null"], "pattern": "^0x[0-9a-f]{4}$" },
          "apiVersion": { "type": ["string", "null"] },
          "licenseConclusion": { "type": ["string", "null"] }
        }
      }
    },
    "closureEvidence": { "type": "object" }
  }
}
