{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xil146.github.io/hvp/schemas/native-source-acquisition-evidence-v1.schema.json",
  "title": "HVP native source acquisition evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "kind", "sourceLockSha256", "archiveCount", "archives"],
  "properties": {
    "$schema": { "const": "../manifests/schemas/source-acquisition-evidence.schema.json" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "hvp-native-source-acquisition-evidence" },
    "sourceLockSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "archiveCount": { "type": "integer", "minimum": 1 },
    "archives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "commit", "archiveName", "sourceUrl", "sha256", "length"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "version": { "type": "string", "minLength": 1 },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "archiveName": { "type": "string", "minLength": 1 },
          "sourceUrl": { "type": "string", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "length": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
