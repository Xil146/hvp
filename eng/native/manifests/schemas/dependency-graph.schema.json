{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xil146.github.io/hvp/schemas/native-dependency-graph-v2.schema.json",
  "title": "HVP native dependency graph v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "approvedNodeIds", "nodes"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "kind": { "const": "hvp-native-dependency-graph" },
    "approvedNodeIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "linkType", "dependsOn"],
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string" },
          "linkType": { "enum": ["shared", "header-only", "build-only"] },
          "dependsOn": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
