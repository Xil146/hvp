<Window x:Class="Hvp.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:windows="clr-namespace:Hvp.Platform.Windows;assembly=Hvp.Platform.Windows"
        Title="HVP"
        Width="960"
        Height="600"
        MinWidth="640"
        MinHeight="420"
        AllowDrop="True"
        KeyDown="Window_KeyDown"
        PreviewDragOver="Window_PreviewDragOver"
        Drop="Window_Drop">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <windows:VideoHost x:Name="VideoHost" AllowDrop="True" />
    <Border Grid.Row="1" Padding="12" Background="#202020">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="120" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Margin="0,0,8,0" Padding="12,4" Click="Open_Click" Content="Open file" />
        <Button x:Name="PlayPauseButton" Grid.Column="1" Margin="0,0,8,0" Padding="12,4" Click="PlayPause_Click" Content="Play" IsEnabled="False" />
        <Button x:Name="StopButton" Grid.Column="2" Margin="0,0,8,0" Padding="12,4" Click="Stop_Click" Content="Stop" IsEnabled="False" />
        <Slider x:Name="SeekSlider" Grid.Column="3" Margin="0,0,12,0" Minimum="0" Maximum="100" IsEnabled="False" ValueChanged="Seek_ValueChanged" />
        <TextBlock x:Name="StatusText" Grid.Column="4" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="White" Text="Open a local video file" />
        <Slider x:Name="VolumeSlider" Grid.Column="5" Minimum="0" Maximum="100" Value="100" ValueChanged="Volume_ValueChanged" />
      </Grid>
    </Border>
  </Grid>
</Window>
